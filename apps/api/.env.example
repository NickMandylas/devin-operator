# Devin API v3 service-user credentials
DEVIN_API_TOKEN=cog_replace_me
DEVIN_ORG_ID=replace_me

# Target fork and GitHub App or fine-grained token
GITHUB_REPOSITORY=NickMandylas/superset
# Optional multi-repository configuration. When set, this replaces GITHUB_REPOSITORY and TRACKED_ISSUES.
# trackedIssues is legacy metadata only; issues are discovered dynamically from GitHub.
GITHUB_REPOSITORIES=[{"repository":"NickMandylas/superset","trackedIssues":[1,2,3,4]}]
GITHUB_TOKEN=github_pat_replace_me
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_value

# Protects the scheduled reconciliation endpoint outside Vercel Cron
CRON_SECRET=replace_with_a_long_random_value

# Shared only with the web server. Required in production.
CONTROL_PLANE_TOKEN=replace_with_a_different_long_random_value

# Automation policy. All open issues are discovered dynamically from GitHub;
# TRACKED_ISSUES is retained for backwards compatibility and only seeds the
# fallback count shown before live data loads.
TRACKED_ISSUES=1,2,3,4
DEVIN_MAX_ACU_LIMIT=25
DEVIN_BASE_URL=https://api.devin.ai/v3
